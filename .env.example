# Django Configuration
# SECURITY WARNING: Keep these values secret in production!

# REQUIRED: Django secret key (already generated)
SECRET_KEY=your-secret-key-here

# Debug mode (set to False in production)
DEBUG=True

# Allowed hosts (comma-separated)
ALLOWED_HOSTS=localhost,127.0.0.1,.localhost

# Supabase Configuration
# Get these from your Supabase Dashboard -> Settings -> API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-key

# Supabase Database Configuration
# Use the Connection Pooler (Session Mode) for best results with Django
# Get this from Supabase Dashboard -> Settings -> Database -> Connection Pooler
DB_NAME=postgres
DB_USER=postgres.your-project-ref
DB_PASSWORD=your-db-password
DB_HOST=aws-0-region.pooler.supabase.com
DB_PORT=5432  # Session pooler port (or 6543 for transaction pooler if supported)

# Email Configuration (optional)
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@example.com
# EMAIL_HOST_PASSWORD=your-email-password
